{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "highest",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 5,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 9,
  "timeout-low": 6,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 500,
  "control-center-height": 600,
  "notification-window-width": 500,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "title",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true
    },
    "backlight": {
      "device": "amdgpu_bl1",
      "label": "",
      "slider": true,
      "min": 10
    },
    "volume": {
      "device": "default",
      "label": "",
      "slider": true
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰂯",
          "type": "button",
          "active": true,
          "command": "swaync-client -t -sw;sh -c 'adw-bluetooth'"
        },
        {
          "label": "⏻",
          "type": "button",
          "active": true,
          "command": "notify-send 'Power'"
        },
        {
          "label": "󰆏",
          "type": "button",
          "active": true,
          "command": "notify-send 'Cliphist Option'"
        },
        {
          "label": "󰊪",
          "type": "toggle",
          "active": false,
          "command": "notify-send 'Blue Light Filter Option'"
        },
        {
          "label": "",
          "type": "button",
          "active": true,
          "command": "notify-send 'Internet Option'"
        },
        {
          "label": "",
          "type": "button",
          "active": true,
          "command": "notify-send 'Print Screen Option'"
        },
        {
          "label": "",
          "type": "button",
          "active": true,
          "command": "notify-send 'Application Launcher'"
        },
        {
          "label": "",
          "type": "button",
          "active": true,
          "command": "notify-send 'Extra Option'"
        }
      ]
    }
  }
}